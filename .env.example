# ---------------------------------------------------------------
# Configuración de Hotel Nube
# Copia este fichero como .env y rellena los valores:
#   cp .env.example .env
# El fichero .env NO se sube al repositorio.
# ---------------------------------------------------------------

# --- Base de datos (MySQL / MariaDB) ---------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hotel

# Usuario con todos los permisos (registro, panel de administración)
DB_USER_ADMIN=hotel_admin
DB_PASSWORD_ADMIN=

# Usuario de solo lectura (login)
DB_USER_CONEXION=hotel_conexion
DB_PASSWORD_CONEXION=

# Usuario de los visitantes (lectura e inserción)
DB_USER_ESTANDAR=hotel_estandar
DB_PASSWORD_ESTANDAR=

# --- Correo (SMTP) ---------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# Si MAIL_HOST está vacío no se envían correos
# tls (STARTTLS, puerto 587), ssl (SMTPS, puerto 465) o vacío (sin cifrado)
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
# Sin usuario no hay autenticación (servidores de pruebas como Mailpit)
# Con Gmail usa una "contraseña de aplicación", no la de la cuenta
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Hotel Nube"

# --- Web --------------------------------------------------------
# URL pública de la web, sin barra final (imágenes de los correos)
SITE_URL=http://localhost:8000
# Zona horaria del hotel (validación de las fechas de las reservas)
TIMEZONE=Europe/Madrid

# --- API de datos y correos (hotelnube-api) --------------------
# URL base sin barra final, tal como la ve el navegador
API_URL=http://localhost:8001
# Opcional: URL de la API desde el servidor PHP, si es distinta
# (en Docker Compose es http://api:8001)
API_INTERNAL_URL=

# --- Migraciones (php scripts/migrar.php) ------------------------
# Usuario con permisos para cambiar el esquema; los usuarios de la
# aplicación no los tienen. En Docker Compose se usa root
DB_USER_MIGRACIONES=root
DB_PASSWORD_MIGRACIONES=

# --- Docker Compose -----------------------------------------------
# Contraseña de root de MariaDB (solo la usa docker-compose.yml)
DB_ROOT_PASSWORD=
