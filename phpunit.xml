<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         failOnDeprecation="true"
         displayDetailsOnTestsThatTriggerDeprecations="true">
    <php>
        <!-- Los errores registrados con error_log no ensucian la salida -->
        <ini name="error_log" value="/dev/null"/>
    </php>
    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <!-- Necesita una base de datos creada con config/db_hotel.sql y
             db_usuarios.sql, y DB_TESTS=1 junto con las variables DB_* -->
        <testsuite name="integracion">
            <directory>tests/Integracion</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>php</directory>
        </include>
    </source>
</phpunit>
