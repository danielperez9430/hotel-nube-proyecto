{
    "name": "danielperez9430/hotel-nube",
    "description": "Web de reservas del hotel Hotel Nube",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.5.12",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "phpmailer/phpmailer": "^7.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.4",
        "phpstan/phpstan": "^2.3"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "find php public views -name '*.php' -print0 | xargs -0 -n1 php -l",
        "analyse": "phpstan analyse --no-progress",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
